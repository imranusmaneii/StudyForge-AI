<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <!-- Dark Blue Gradients for 3D Depth & Crystal Clarity -->
    <linearGradient id="capTopLeft" x1="3" y1="23" x2="32" y2="23" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1E40AF"/>
      <stop offset="40%" stop-color="#1E3A8A"/>
      <stop offset="100%" stop-color="#0F245E"/>
    </linearGradient>
    <linearGradient id="capTopRight" x1="32" y1="23" x2="61" y2="23" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#172554"/>
      <stop offset="60%" stop-color="#0F1D4A"/>
      <stop offset="100%" stop-color="#0A1332"/>
    </linearGradient>
    <linearGradient id="capBevel" x1="3" y1="23" x2="61" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1D4ED8"/>
      <stop offset="50%" stop-color="#172554"/>
      <stop offset="100%" stop-color="#0B132B"/>
    </linearGradient>
    <linearGradient id="capBand" x1="16" y1="30" x2="48" y2="49" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1E3A8A"/>
      <stop offset="60%" stop-color="#172554"/>
      <stop offset="100%" stop-color="#080F24"/>
    </linearGradient>
    <linearGradient id="tasselCord" x1="32" y1="23" x2="54" y2="45" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#93C5FD"/>
      <stop offset="35%" stop-color="#60A5FA"/>
      <stop offset="100%" stop-color="#2563EB"/>
    </linearGradient>
    <linearGradient id="tasselBrush" x1="49" y1="45" x2="59" y2="58" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1E40AF"/>
      <stop offset="50%" stop-color="#1D4ED8"/>
      <stop offset="100%" stop-color="#0F286E"/>
    </linearGradient>
  </defs>

  <!-- 1. Skullcap Headband (Underneath Mortarboard) -->
  <path d="M16 30 V42.5 C16 49.5 48 49.5 48 42.5 V30 Z" 
        fill="url(#capBand)" 
        stroke="#3B82F6" 
        stroke-width="1.6" 
        stroke-linejoin="round"/>

  <!-- Skullcap Bottom Accent Ribbon -->
  <path d="M18.5 39 C24.5 44 39.5 44 45.5 39" 
        stroke="#60A5FA" 
        stroke-width="1.4" 
        stroke-linecap="round" 
        fill="none" 
        opacity="0.9"/>

  <!-- 2. Mortarboard 3D Edge / Rim (Gives physical slab thickness) -->
  <polygon points="3,23 32,39 61,23 61,25.5 32,41.5 3,25.5" 
           fill="url(#capBevel)" 
           stroke="#2563EB" 
           stroke-width="0.8"/>

  <!-- 3. Mortarboard Diamond Top - Left Half (Lit Side) -->
  <polygon points="32,7 32,39 3,23" 
           fill="url(#capTopLeft)" 
           stroke="#3B82F6" 
           stroke-width="1.6" 
           stroke-linejoin="round"/>

  <!-- 4. Mortarboard Diamond Top - Right Half (Shadow Side) -->
  <polygon points="32,7 61,23 32,39" 
           fill="url(#capTopRight)" 
           stroke="#3B82F6" 
           stroke-width="1.6" 
           stroke-linejoin="round"/>

  <!-- Crisp Central Ridge Line for 3D Geometry Definition -->
  <line x1="32" y1="7" x2="32" y2="39" stroke="#60A5FA" stroke-width="1" stroke-linecap="round" opacity="0.8"/>

  <!-- Front Bevel Highlight Edge (Guarantees Razor-Sharp Contrast on Dark & Light Windows Tabs) -->
  <path d="M3 23 L32 39 L61 23" 
        stroke="#93C5FD" 
        stroke-width="1.6" 
        stroke-linecap="round" 
        stroke-linejoin="round"/>

  <!-- Back Edges Outline -->
  <path d="M3 23 L32 7 L61 23" 
        stroke="#60A5FA" 
        stroke-width="1.6" 
        stroke-linecap="round" 
        stroke-linejoin="round"/>

  <!-- 5. Center Button -->
  <ellipse cx="32" cy="23" rx="3.5" ry="2.4" fill="#0F245E" stroke="#93C5FD" stroke-width="1.4"/>

  <!-- 6. Dark Blue & Azure Tassel Cord -->
  <path d="M32 23 C42 23.5 52.5 26.5 53.5 31.5 L53.5 44" 
        fill="none" 
        stroke="url(#tasselCord)" 
        stroke-width="2.2" 
        stroke-linecap="round"/>

  <!-- Tassel Ring Connector -->
  <ellipse cx="53.5" cy="44" rx="2" ry="1.4" fill="#60A5FA" stroke="#93C5FD" stroke-width="0.8"/>

  <!-- Tassel Fringe Brush -->
  <polygon points="50,45.5 57,45.5 58.5,57.5 48.5,57.5" 
           fill="url(#tasselBrush)" 
           stroke="#60A5FA" 
           stroke-width="1" 
           stroke-linejoin="round"/>
  <!-- Individual Thread Highlights -->
  <line x1="51.5" y1="46" x2="50.5" y2="57" stroke="#93C5FD" stroke-width="0.8" opacity="0.9"/>
  <line x1="53.5" y1="46" x2="53.5" y2="57" stroke="#BFDBFE" stroke-width="0.9"/>
  <line x1="55.5" y1="46" x2="56.5" y2="57" stroke="#93C5FD" stroke-width="0.8" opacity="0.9"/>
</svg>
